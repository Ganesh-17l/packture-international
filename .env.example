# PACKTURE INTERNATIONAL B2B QUOTE EMAIL SERVICE CONFIGURATION
# Copy this file to .env and configure your production credentials.
# Do NOT commit your active .env file to public version control systems.

# 1. Sales Recipient Address
# The destination address where the Packture sales team receives B2B quote notifications.
# Replace with the client's preferred address (e.g. sales@packtureinternational.in)
PACKTURE_SALES_EMAIL=sales@example.com

# 2. Verified Sender Address
# This must be a verified sender domain configured on your email provider account.
# Using a verified domain prevents delivery failures and spoofing flags.
# Do NOT use a user's submitted email address in this field.
PACKTURE_FROM_EMAIL=no-reply@example.com

# 3. Email Provider Credentials
# Supports Resend (default) or SendGrid APIs. Set your API Key here.
EMAIL_API_KEY=your_server_side_email_api_key

# 4. Optional: Custom Provider Selector
# Set to 'resend' or 'sendgrid' to explicitly force a provider. Defaults to 'resend'.
EMAIL_PROVIDER=resend

# 5. Optional: Toggle Customer Confirmation Email
# Set to 'true' to send a receipt email to the user. Defaults to 'true'.
SEND_CUSTOMER_CONFIRMATION=true
